# Database — use Neon, Supabase, or Render PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth — REQUIRED in production (server refuses to start without it)
JWT_SECRET="your-secret-key-here"

# Server
PORT=5000
NODE_ENV="development"

# CORS — comma-separated allowlist of frontend origins.
# Leave empty in development to allow all; ALWAYS set in production.
CORS_ORIGIN="http://localhost:3000"

# Optional: override built-in admin bootstrap / recovery code (change these!)
ADMIN_EMAIL="admin123@gmail.com"
ADMIN_PASSWORD="123456"
RECOVERY_CODE="email1234"

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_BUCKET_NAME="projectflowuploads"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"
